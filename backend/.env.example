# ==============================================================================
# FleetFlow Backend Environment Variables Template (.env.example)
# Copy this file to backend/.env and replace placeholders with real values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Core Django Settings
SECRET_KEY=your-django-secret-key-at-least-50-characters-long-example-only
DEBUG=True
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration (PostgreSQL recommended; sqlite3 supported for quick test)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fleetflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration (comma-separated frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Gateway Configuration (STATIC_QR / RAZORPAY / STRIPE mock)
PAYMENT_MODE=STATIC_QR
PAYMENT_GATEWAY_SECRET=your_mock_payment_gateway_secret_here

# Email Configuration (SMTP / console / filebased)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=FleetFlow <noreply@fleetflow.com>
EMAIL_TIMEOUT=10

# Business Rules
BLOCK_TRIPS_ON_EXPIRED_DOCUMENTS=True

# Production Security Flags (enforced when DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
