{
  "name": "fleetflow-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.8",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "node scripts/check_images.js && react-scripts test --watchAll=false",
    "check:images": "node scripts/check_images.js",
    "check:colors": "node scripts/check_colors.js",
    "check:contrast": "node scripts/check_contrast.js",
    "check:tables": "node scripts/check_tables.js",
    "check:buttons": "node scripts/check_buttons.js",
    "lint": "eslint src",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "JSXOpeningElement > JSXIdentifier[name=/^(input|select|textarea)$/]",
          "message": "Do not use raw <input>, <select>, or <textarea>. Use shared components from src/components/forms instead."
        },
        {
          "selector": "JSXOpeningElement > JSXIdentifier[name='button']",
          "message": "Do not use raw <button>. Use shared Button or IconButton from src/components/common instead."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/components/forms/**"
        ],
        "rules": {
          "no-restricted-syntax": [
            "error",
            {
              "selector": "JSXOpeningElement > JSXIdentifier[name='button']",
              "message": "Do not use raw <button>. Use shared Button or IconButton from src/components/common instead."
            }
          ]
        }
      },
      {
        "files": [
          "src/components/common/Button.js",
          "src/components/common/IconButton.js"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.13.0"
  }
}